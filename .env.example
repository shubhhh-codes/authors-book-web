# ── Shiprocket Checkout (SRC) ──────────────────────────────────
NEXT_PUBLIC_SRC_API_KEY=your_src_api_key_here
NEXT_PUBLIC_SRC_CHANNEL_ID=your_channel_id_here
SRC_SECRET_KEY=your_src_secret_key_here
SRC_API_BASE_URL=https://checkout-api.shiprocket.in/api/v1
NEXT_PUBLIC_APP_URL=https://authorsbook.store