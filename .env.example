# ═════════════════════════════════════════════════════════════════════════════
# authorsbook.store - Environment Variables Configuration
# ═════════════════════════════════════════════════════════════════════════════
#
# HOW TO USE THIS FILE:
# 1. Copy this file to .env.local:  cp .env.example .env.local
# 2. Fill in the REQUIRED variables (database, payment gateway)
# 3. Fill in OPTIONAL variables if you want WhatsApp/Email
# 4. NEVER commit .env.local to Git (it's in .gitignore)
# 5. For production, add these to Vercel dashboard
#
# ⚠️  SECURITY: Keep all secrets private. Never share these values.

# ═════════════════════════════════════════════════════════════════════════════
# ✅ REQUIRED: Database Configuration
# ═════════════════════════════════════════════════════════════════════════════

# MongoDB Atlas Connection String
# WHERE TO GET: https://www.mongodb.com/cloud/atlas
# STEPS:
#   1. Create/Login to MongoDB Atlas
#   2. Create a cluster (free tier available)
#   3. Click "Connect" → "Connect your application"
#   4. Copy connection string (replace <password> and <username>)
# FORMAT: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/authorsbook?retryWrites=true&w=majority


# ═════════════════════════════════════════════════════════════════════════════
# ✅ REQUIRED: Payment Gateway (Razorpay)
# ═════════════════════════════════════════════════════════════════════════════

# Razorpay Live API Key ID
# WHERE TO GET: https://dashboard.razorpay.com/app/keys
# STEPS:
#   1. Login to Razorpay Dashboard
#   2. Go to: Settings → API Keys
#   3. Copy the "Key ID" (public key, safe to expose)
# NOTE: Use LIVE keys in production, TEST keys for development
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxxxx

# Razorpay Live API Key Secret
# WHERE TO GET: https://dashboard.razorpay.com/app/keys
# STEPS:
#   1. Login to Razorpay Dashboard
#   2. Go to: Settings → API Keys
#   3. Copy the "Key Secret" (⚠️ KEEP THIS SECRET!)
# ⚠️  NEVER expose this in frontend code or logs
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx


# ═════════════════════════════════════════════════════════════════════════════
# 🔐 RECOMMENDED: Authentication & Security
# ═════════════════════════════════════════════════════════════════════════════

# NEXTAUTH/JWT Secret for Admin Session Tokens
# GENERATE: Run this in terminal:  openssl rand -base64 32
# Or use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PURPOSE: Secures admin authentication & session management
# MINIMUM: 32 characters, random string
NEXTAUTH_SECRET=your_strong_random_secret_key_here_32_chars_min

# Admin Panel Login Password
# DEFAULT: changeMe123! (development only)
# PRODUCTION: Change to something strong & unique
# WARNING: This is for /admin/login page
ADMIN_PASSWORD=changeMe123!


# ═════════════════════════════════════════════════════════════════════════════
# 📱 OPTIONAL: WhatsApp Business Notifications
# ═════════════════════════════════════════════════════════════════════════════
#
# COST: ~₹0.114 per order confirmation (customer initiated messages FREE)
# With 1000 orders/month: ~₹114/month
# BENEFIT: 98% open rate vs 18% for email
#
# SETUP STEPS:
#   1. Create Meta Business Account: https://business.facebook.com
#   2. Set up WhatsApp Business Account (WABA)
#   3. Get Phone Number ID from: WhatsApp Manager → API Setup
#   4. Generate Access Token from: Meta App Dashboard → Tokens
#   5. Create message templates in: WhatsApp Manager → Message Templates
#
# NOTE: If not configured, order confirmations still work via email
#       WhatsApp is optional but recommended for better engagement

# WhatsApp Business Account Phone Number ID
# WHERE TO GET: https://business.facebook.com/wa/manage/phone-numbers/
# STEPS:
#   1. Go to WhatsApp Manager
#   2. Select your phone number
#   3. Copy the "Phone Number ID" (15-16 digit number)
# FORMAT: Numeric ID only (e.g., 1234567890123456)
WABA_PHONE_ID=1234567890123456

# WhatsApp Cloud API Access Token
# WHERE TO GET: Meta App Dashboard (https://developers.facebook.com/)
# STEPS:
#   1. Go to your Meta App → Tools & Support
#   2. Generate new access token in: System Users
#   3. Select Scopes: whatsapp_business_messaging
#   4. Copy the token (starts with "EAAxx...")
# FORMAT: Long string starting with "EAA"
# ⚠️  KEEP THIS SECRET - DO NOT SHARE
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WhatsApp Business Phone Number (for reference)
# FORMAT: +91XXXXXXXXXX (Indian number with country code)
# NOTE: This is just for reference - not used in code
WHATSAPP_BUSINESS_PHONE=+919876543210


# ═════════════════════════════════════════════════════════════════════════════
# 📧 OPTIONAL: Email Notifications (Future Feature)
# ═════════════════════════════════════════════════════════════════════════════
#
# Not yet implemented in current version
# But prepared for future use with SendGrid
#
# SendGrid API Key
# WHERE TO GET: https://app.sendgrid.com/settings/api_keys
# STEPS:
#   1. Login to SendGrid
#   2. Go to: Settings → API Keys
#   3. Create new API Key
#   4. Copy the key (starts with "SG.")
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ═════════════════════════════════════════════════════════════════════════════
# 🚀 OPTIONAL: Shipping Integration (Future Feature)
# ═════════════════════════════════════════════════════════════════════════════
#
# Not yet implemented in current version
# Prepared for Shiprocket integration
#
# SHIPROCKET_API_KEY=your_shiprocket_api_key_here


# ═════════════════════════════════════════════════════════════════════════════
# 📊 OPTIONAL: Analytics & Tracking (Future Feature)
# ═════════════════════════════════════════════════════════════════════════════
#
# Google Analytics 4 (for tracking user behavior)
# WHERE TO GET: https://analytics.google.com/
# NEXT_PUBLIC_GA_ID=G-xxxxxxxxxx
#
# Google Search Console (for SEO verification)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxx


# ═════════════════════════════════════════════════════════════════════════════
# ⚙️  NEXT.JS & NODE SETTINGS
# ═════════════════════════════════════════════════════════════════════════════

# Environment (automatically set by Vercel, override if needed)
# Options: development | production
NODE_ENV=development

# Debug mode (set true for detailed console logs)
DEBUG=false


# ═════════════════════════════════════════════════════════════════════════════
# 📋 QUICK SETUP CHECKLIST
# ═════════════════════════════════════════════════════════════════════════════

# MINIMUM (to get store working):
# ✅ MONGODB_URI
# ✅ RAZORPAY_KEY_ID
# ✅ RAZORPAY_KEY_SECRET
# ✅ NEXTAUTH_SECRET (recommended)

# RECOMMENDED (for better user experience):
# ✅ WABA_PHONE_ID
# ✅ WHATSAPP_ACCESS_TOKEN
# ✅ Strong ADMIN_PASSWORD

# DEPLOYMENT (Vercel):
# Copy all above variables to: Vercel Dashboard → Project Settings → Environment Variables


# ═════════════════════════════════════════════════════════════════════════════
# 🔧 LOCAL DEVELOPMENT SETUP
# ═════════════════════════════════════════════════════════════════════════════

# 1. COPY THIS FILE:
#    cp .env.example .env.local

# 2. FILL IN REQUIRED FIELDS:
#    • MONGODB_URI (get from MongoDB Atlas)
#    • RAZORPAY_KEY_ID (from Razorpay dashboard)
#    • RAZORPAY_KEY_SECRET (from Razorpay dashboard)

# 3. OPTIONAL - SET UP WHATSAPP:
#    • Get WABA_PHONE_ID from WhatsApp Manager
#    • Get WHATSAPP_ACCESS_TOKEN from Meta dashboard
#    • Create templates in WhatsApp Manager

# 4. INSTALL & START:
#    npm install
#    npm run dev
#    Open http://localhost:3000

# 5. TEST CHECKOUT:
#    • Add product to cart
#    • Proceed to checkout
#    • Use Razorpay test card (if in test mode)
#    • Verify order in MongoDB


# ═════════════════════════════════════════════════════════════════════════════
# 🐛 TROUBLESHOOTING
# ═════════════════════════════════════════════════════════════════════════════

# ERROR: "Please define MONGODB_URI"
# FIX: Make sure MONGODB_URI is set in .env.local
#      If you get "ECONNREFUSED": MongoDB Atlas server might be down

# ERROR: "Razorpay order creation failed"
# FIX: Check that RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET are correct
#      Make sure they're LIVE keys (not TEST keys) for production

# ERROR: "Rate limit exceeded"
# FIX: Too many checkout requests from same IP
#      Wait 1 minute for limit to reset
#      This is a security feature (protects against attacks)

# ERROR: "WhatsApp notifications not sending"
# FIX: Check WABA_PHONE_ID and WHATSAPP_ACCESS_TOKEN
#      Verify message templates exist in WhatsApp Manager
#      WhatsApp is optional - order still completes even if WhatsApp fails

# ERROR: "Admin login doesn't work"
# FIX: Default password is "changeMe123!"
#      Make sure ADMIN_PASSWORD is set in .env.local

# ERROR: "npm install fails"
# FIX: Clear npm cache: npm cache clean --force
#      Then retry: npm install


# ═════════════════════════════════════════════════════════════════════════════
# 🔐 SECURITY BEST PRACTICES
# ═════════════════════════════════════════════════════════════════════════════

# ⚠️  NEVER:
# • Commit .env.local to Git
# • Share these values in Slack/Email/Chat
# • Hardcode these values in your code
# • Use the same secrets for dev and production
# • Log sensitive values to console

# ✅ ALWAYS:
# • Keep .env.local in .gitignore (it already is)
# • Use strong random secrets (minimum 32 characters)
# • Rotate secrets periodically
# • Use different secrets for each environment (dev/staging/prod)
# • Store production secrets in Vercel dashboard (not in Git)
# • Review .gitignore to ensure .env.local is ignored

# TO GENERATE SECURE RANDOM SECRETS:
# openssl rand -base64 32
# OR
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"


